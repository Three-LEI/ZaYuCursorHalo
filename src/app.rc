#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"

IDI_TRAY_ACTIVE ICON "../res/tray_active.ico"
IDI_TRAY_PAUSED ICON "../res/tray_paused.ico"
IDR_TIMER_FONT RCDATA "../res/dseg7-modern.ttf"
IDR_CLICK_LEFT WAVE "../res/click_left.wav"
IDR_CLICK_RIGHT WAVE "../res/click_right.wav"
IDR_CLICK_SOFT_LEFT WAVE "../res/click_soft_left.wav"
IDR_CLICK_SOFT_RIGHT WAVE "../res/click_soft_right.wav"
IDR_CLICK_CRISP_LEFT WAVE "../res/click_crisp_left.wav"
IDR_CLICK_CRISP_RIGHT WAVE "../res/click_crisp_right.wav"
IDR_CLICK_WOOD_LEFT WAVE "../res/click_wood_left.wav"
IDR_CLICK_WOOD_RIGHT WAVE "../res/click_wood_right.wav"
IDR_CLICK_SYNTH_LEFT WAVE "../res/click_synth_left.wav"
IDR_CLICK_SYNTH_RIGHT WAVE "../res/click_synth_right.wav"

IDD_COUNTDOWN DIALOGEX 0, 0, 180, 82
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Custom countdown"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Minutes (1-99)", IDC_COUNTDOWN_LABEL, 12, 10, 156, 10
    EDITTEXT IDC_COUNTDOWN_EDIT, 12, 24, 156, 14, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 60, 54, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 116, 54, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "three-lei x DeepSeek"
            VALUE "FileDescription", "ZaYuCursorHalo mouse highlight and timer"
            VALUE "FileVersion", "0.3.0.0"
            VALUE "InternalName", "ZaYuCursorHalo"
            VALUE "LegalCopyright", "three-lei x DeepSeek"
            VALUE "OriginalFilename", "ZaYuCursorHalo.exe"
            VALUE "ProductName", "ZaYuCursorHalo"
            VALUE "ProductVersion", "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
